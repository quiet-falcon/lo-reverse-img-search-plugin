{
	"name": "lo-reverse-img-search-plugin",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "valenced-plugin build",
		"build:dev": "valenced-plugin build --dev",
		"generate-index": "valenced-plugin generate-index",
		"plan-releases": "valenced-plugin plan-releases --plugins-dir plugins",
		"serve": "valenced-plugin serve",
		"lint": "biome check",
		"typecheck": "tsc -b plugins/*/tsconfig.json && tsc -p tests/tsconfig.json",
		"test": "bun test tests",
		"verify": "bun run lint && bun run typecheck && bun run test && bun run build reverse-image-search"
	},
	"dependencies": {
		"@revenge-mod/devtools-client": "^1.4.0",
		"@revenge-mod/devtools-shared": "^1.3.0",
		"@valenced/plugin-cli": "git+https://github.com/Valenced/valenced-plugin-cli.git#9ea9f9bfc91319e2b18c6b1c9ac0b993f8600c1d",
		"@valenced/types": "git+https://github.com/Valenced/valenced-types.git#c67dd726d1ec28b38d8ac93862fdd3b6029b1d29"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "1.4.4",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"react-native": "0.81.6",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@react-native/community-cli-plugin": "npm:dry-uninstall",
		"@react-native/codegen": "npm:dry-uninstall",
		"babel-jest": "npm:dry-uninstall",
		"babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
		"hermes-compiler": "npm:dry-uninstall",
		"jsc-android": "npm:dry-uninstall",
		"react-devtools-core": "npm:dry-uninstall",
		"recyclerlistview": "npm:dry-uninstall",
		"react-native-gesture-handler": "npm:dry-uninstall",
		"react-native-screens": "npm:dry-uninstall"
	},
	"trustedDependencies": [
		"@valenced/plugin-cli",
		"@swc/core"
	]
}
